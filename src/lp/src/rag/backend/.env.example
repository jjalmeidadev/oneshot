# Copie para .env e ajuste. O serviço sobe sem nenhuma destas variáveis.

# --- Rede ---------------------------------------------------------------
# Origens autorizadas no CORS, separadas por vírgula. Em desenvolvimento a LP
# roda em http://localhost:5173; publicado, é o domínio da landing page.
CORS_ALLOW_ORIGINS=*
# Origens por expressão regular, para os preview deploys da Vercel, cujo
# domínio muda a cada branch. Ex.: https://.*\.vercel\.app
CORS_ALLOW_ORIGIN_REGEX=
HOST=127.0.0.1
PORT=8000

# --- Presença ao vivo ---------------------------------------------------
SESSION_TTL_SECONDS=90
SWEEP_INTERVAL_SECONDS=15
MAX_SESSIONS=50
MAX_MESSAGES_PER_SESSION=200

# --- Modelo RAG ----------------------------------------------------------
# `local` roda o modelo de lp/src/rag/model dentro deste processo — é o que o
# projeto usa. `http` fala com ele publicado como serviço próprio. `none`
# recusa com 503.
RAG_MODEL_BACKEND=local
RAG_MODEL_URL=
RAG_MODEL_TIMEOUT_SECONDS=60

# Chave do Gemini, usada pelo modelo para vetorizar a pergunta e gerar a
# resposta. A mesma que já existe em src/backend/.env.
GEMINI_API_KEY=
# Opcionais: ver o README de lp/src/rag/model.
GEMINI_MODEL=gemini-3.7-flash
RAG_TOP_K=5
RAG_MIN_SCORE=0.30

# --- Bancada de teste ----------------------------------------------------
# Serve /teste. Deixe ligada enquanto o chat da LP não estiver integrado: é a
# única forma de colocar mensagem na sala. Desligue quando não for mais.
ENABLE_TEST_BENCH=true

# --- Documentos ----------------------------------------------------------
# Padrão: ../documentsRAG (irmã desta pasta).
DOCUMENTS_DIR=
