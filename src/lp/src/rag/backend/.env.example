# Copie para .env e ajuste. O serviço sobe sem nenhuma destas variáveis.

# --- Rede ---------------------------------------------------------------
# Origens autorizadas no CORS, separadas por vírgula. Em desenvolvimento a LP
# roda em http://localhost:5173.
CORS_ALLOW_ORIGINS=*
HOST=127.0.0.1
PORT=8000

# --- Presença ao vivo ---------------------------------------------------
SESSION_TTL_SECONDS=90
SWEEP_INTERVAL_SECONDS=15
MAX_SESSIONS=50
MAX_MESSAGES_PER_SESSION=200

# --- Modelo RAG (próxima task) ------------------------------------------
# `none` enquanto lp/src/rag/model não existir; `http` quando ele estiver
# publicado como serviço próprio.
RAG_MODEL_BACKEND=none
RAG_MODEL_URL=
RAG_MODEL_TIMEOUT_SECONDS=60

# --- Documentos ----------------------------------------------------------
# Padrão: ../documentsRAG (irmã desta pasta).
DOCUMENTS_DIR=
