# Provedor do LLM. A bancada de teste usa gemini (API direta do Google), no
# Free Tier, para nao gerar custo. No ambiente do Metro o agente usara o
# Copilot Studio com modelos GPT.
# openrouter existe apenas para executar os testes de RNF quando a quota do
# Free Tier do Gemini nao comporta a rodada: deixe gemini aqui e ative o
# OpenRouter somente no comando que sobe a API de teste, por exemplo
#   LLM_PROVIDER=openrouter uvicorn app.main:app
# O OpenRouter nao guarda estado entre chamadas: previous_interaction_id e
# ignorado e cada pergunta e respondida sem o historico da conversa.
LLM_PROVIDER=gemini
OPENROUTER_API_KEY=sua-chave-do-openrouter
# Modelo no formato do OpenRouter. O padrao e o mesmo modelo da bancada.
OPENROUTER_MODEL=google/gemini-3.7-flash

GEMINI_API_KEY=sua-chave-do-google-ai-studio
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_THINKING_LEVEL=low
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_SECONDS=2
RAG_MAX_SOURCES=3
# Tempo maximo, entre 30 e 3600 segundos, para aceitar ou recusar uma sugestao.
PROACTIVE_SUGGESTION_TTL_SECONDS=900
PLN_WARMUP=1
# Snapshot imutavel usado pelo BERTimbau e pelo tokenizador.
PLN_BERT_MODEL=neuralmind/bert-base-portuguese-cased
PLN_BERT_REVISION=94d69c95f98f7d5b2a8700c420230ae10def0baa
# SHAREPOINT_MOCK_DATA_DIR=C:/caminho/para/exports-json

# PostgreSQL/Supabase (copie do painel Connect do projeto; nao versionar segredo real)
# Use DATABASE_URL preferencialmente. SUPABASE_DATABASE_URL e aceito como alias.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
SUPABASE_DATABASE_URL=
# Opcionais. Pool de conexoes (padrao ligado, ate 5 conexoes) e limite de
# tempo de cada consulta, em ms (padrao 5000, contido entre 500 e 60000). Sem o
# limite, uma gravacao presa no banco segura a resposta ao usuario sem prazo.
# DATABASE_POOL_ENABLED=1
# DATABASE_POOL_MAX_SIZE=5
# DATABASE_STATEMENT_TIMEOUT_MS=5000

# Azure AI Speech (Speech-to-Text)
AZURE_SPEECH_RESOURCE=nome-do-recurso
# Use quando o portal exibir um endpoint regional como
# https://eastus.api.cognitive.microsoft.com/
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=sua-chave-do-azure-speech
# O RNF05 da 10 segundos para uma consulta simples ponta a ponta, e a
# transcricao e so a primeira etapa. O backend limita o valor entre 1 e 120.
AZURE_SPEECH_TIMEOUT_SECONDS=6
# Tentativas totais em falha transitoria do provedor (limite entre 1 e 5).
AZURE_SPEECH_MAX_ATTEMPTS=2

# Identidades simuladas do endpoint de audio, no formato
# <token>=<entra_object_id>, separadas por virgula. Substituem o token do
# Microsoft Entra ID enquanto o ambiente corporativo nao esta provisionado.
# Vazio em desenvolvimento: o cabecalho Authorization continua obrigatorio,
# mas qualquer token e aceito e o identificador e derivado dele.
AUDIO_SIMULATED_IDENTITIES=
