GEMINI_API_KEY=sua-chave-do-google-ai-studio
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_THINKING_LEVEL=low
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_SECONDS=2
RAG_MAX_SOURCES=3
# Tempo maximo, entre 30 e 3600 segundos, para aceitar ou recusar uma sugestao.
PROACTIVE_SUGGESTION_TTL_SECONDS=900
PLN_WARMUP=1
# Snapshot imutavel usado pelo BERTimbau e pelo tokenizador.
PLN_BERT_MODEL=neuralmind/bert-base-portuguese-cased
PLN_BERT_REVISION=94d69c95f98f7d5b2a8700c420230ae10def0baa
# SHAREPOINT_MOCK_DATA_DIR=C:/caminho/para/exports-json

# PostgreSQL/Supabase (copie do painel Connect do projeto; nao versionar segredo real)
# Use DATABASE_URL preferencialmente. SUPABASE_DATABASE_URL e aceito como alias.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
SUPABASE_DATABASE_URL=

# Azure AI Speech (Speech-to-Text)
AZURE_SPEECH_RESOURCE=nome-do-recurso
# Use quando o portal exibir um endpoint regional como
# https://eastus.api.cognitive.microsoft.com/
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=sua-chave-do-azure-speech
# O RNF05 da 10 segundos para uma consulta simples ponta a ponta, e a
# transcricao e so a primeira etapa. O backend limita o valor entre 1 e 120.
AZURE_SPEECH_TIMEOUT_SECONDS=6
# Tentativas totais em falha transitoria do provedor (limite entre 1 e 5).
AZURE_SPEECH_MAX_ATTEMPTS=2

# Identidades simuladas do endpoint de audio, no formato
# <token>=<entra_object_id>, separadas por virgula. Substituem o token do
# Microsoft Entra ID enquanto o ambiente corporativo nao esta provisionado.
# Vazio em desenvolvimento: o cabecalho Authorization continua obrigatorio,
# mas qualquer token e aceito e o identificador e derivado dele.
AUDIO_SIMULATED_IDENTITIES=

# Geracao de relatorios. Use power_automate_simulator para exercitar o callback
# sem depender do tenant Microsoft.
REPORT_EXECUTION_MODE=local
REPORT_REPOSITORY_MODE=memory
REPORT_STORAGE_MODE=local
# Fonte dos dados de portfolio do relatorio: "synthetic" (massa em JSON, padrao)
# ou "database" (le projetos/riscos/marcos/beneficios das tabelas reais do PostgreSQL).
# Para "database", rode antes o seed src/database/sql/13_seed_portfolio_report_data.sql.
REPORT_PORTFOLIO_SOURCE=synthetic
# JSON: {"token-local":{"subject":"usuario-1","display_name":"Usuario","role":"pmo","can_export":true,"allow_all":true}}
REPORT_SIMULATED_IDENTITIES=
# Token selecionado do mapa acima para uso exclusivo do comando local.
REPORT_CLI_TOKEN=
# Segredos devem ser injetados pelo ambiente e nunca versionados.
REPORT_CONFIRMATION_SECRET=
REPORT_CALLBACK_TOKEN=
# Opcional; padrao: src/backend/.runtime/reports
REPORT_ARTIFACTS_DIR=

# Power Automate real. O fluxo recebe o snapshot autorizado e devolve apenas
# JSON estruturado para /api/integrations/power-automate/report-results.
POWER_AUTOMATE_REPORT_TRIGGER_URL=
POWER_AUTOMATE_TRIGGER_TOKEN=
POWER_AUTOMATE_TRIGGER_TIMEOUT_SECONDS=20
REPORT_CALLBACK_BASE_URL=

# Alertas internos. O modo memory/synthetic permite testes sem infraestrutura.
ALERT_REPOSITORY_MODE=memory
ALERT_SCHEDULE_SOURCE=synthetic
ALERT_CONFIRMATION_SECRET=replace-with-at-least-32-random-characters
ALERT_CLI_TOKEN=
RABBITMQ_URL=amqp://metro:metro-local@127.0.0.1:5672/
ALERT_SCHEDULER_INTERVAL_SECONDS=60
ALERT_OUTBOX_POLL_SECONDS=2
ALERT_DATA_FRESHNESS_DAYS=45

# Supabase Storage privado. A service role existe somente no backend.
# ATENCAO: SUPABASE_URL e o endpoint HTTPS da API (https://<project-ref>.supabase.co),
# usado pela Storage API. NAO e a SUPABASE_DATABASE_URL (conexao Postgres/pooler,
# porta 5432/6543). Pegue o valor em Project Settings > API > Project URL.
# Para ativar o armazenamento real, defina REPORT_STORAGE_MODE=supabase (acima).
SUPABASE_URL=
# Secret key (sb_secret_...) em Project Settings > API Keys. Equivale a service_role;
# bypassa RLS. Nunca use a publishable/anon aqui e nunca versione o valor real.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=generated-reports
SUPABASE_STORAGE_AUTO_CREATE=true
SUPABASE_STORAGE_TIMEOUT_SECONDS=20
