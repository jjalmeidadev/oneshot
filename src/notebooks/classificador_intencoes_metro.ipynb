     "text": [
      "LIMIAR_MACRO    = 0.550  (alvo de 97% de acerto atingido: False)\n",
      " limiar  cobertura  acuracia_nos_aceitos\n",
      "   0.55      0.974                0.9316\n",
      "\n",
      "LIMIAR_INTENCAO = 0.700  (alvo de 80% de acerto atingido: True)\n",
