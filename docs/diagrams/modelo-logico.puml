@startuml modelo-logico
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 55
skinparam class {
  BackgroundColor #EEF4FD
  BorderColor #4A7EBB
  ArrowColor #4A5560
  FontSize 12
  AttributeFontSize 10
}
hide circle
left to right direction

entity subportfolios {
  **id** : uuid <<PK>>
  partner_source_id : string
  code : string
  title : string
  responsible_name : string
  gpm_member_name : string
  approver_name : string
  support_name : string
}
entity subportfolio_status_updates {
  **id** : uuid <<PK>>
  subportfolio_id : uuid <<FK>>
  partner_source_id : string
  item : string
  reference_date : date
  situation : string
  year_label : string
}
entity projects {
  **id** : uuid <<PK>>
  subportfolio_id : uuid <<FK>>
  partner_source_id : string
  code : string
  title : string
  program_project_status : string
  status : string
}
entity project_progress_updates {
  **id** : uuid <<PK>>
  project_id : uuid <<FK>>
  partner_source_id : string
  reference_date : date
  planned_physical : decimal
  actual_physical : decimal
  planned_economic : decimal
  actual_economic : decimal
  situation : string
  year_label : string
}
entity project_deliverables_milestones {
  **id** : uuid <<PK>>
  project_id : uuid <<FK>>
  description : text
  planned_date : date
  completed_date : date
  status : string
}
entity project_artifacts {
  **id** : uuid <<PK>>
  project_id : uuid <<FK>>
  partner_source_id : string
  artifact_type : string
  title : string
  sharepoint_url : string
  attachment_name : string
  attachment_url : string
  excel_sheet_name : string
  excel_table_or_range : string
  confidentiality_level : string
  metadata : json
}
entity source_extracts {
  **id** : uuid <<PK>>
  artifact_id : uuid <<FK>>
  project_id : uuid <<FK>>
  extract_index : int
  content_text : text
  source_locator : string
  sharepoint_reference : string
  source_sheet_name : string
  source_row_number : int
  source_cell_range : string
}
entity schedule_items {
  **id** : uuid <<PK>>
  project_id : uuid <<FK>>
  artifact_id : uuid <<FK>>
  parent_item_id : uuid <<FK>>
  wbs_code : string
  activity_name : string
  responsible_name : string
  planned_end_date : date
  actual_end_date : date
  progress_percent : decimal
  status : string
  source_row_number : int
}
entity risk_issue_items {
  **id** : uuid <<PK>>
  scope_type : string
  project_id : uuid <<FK>>
  subportfolio_id : uuid <<FK>>
  partner_source_id : string
  item : string
  updated_on : date
  criticality : string
  risk_or_issue_text : text
  action_plan : text
  planned_resolution_date : date
  should_escalate : boolean
  status : string
}
entity risk_issue_history {
  **id** : uuid <<PK>>
  risk_issue_id : uuid <<FK>>
  reference_date : date
  previous_status : string
  new_status : string
  previous_criticality : string
  new_criticality : string
  comment_text : text
}
entity change_records {
  **id** : uuid <<PK>>
  scope_type : string
  project_id : uuid <<FK>>
  subportfolio_id : uuid <<FK>>
  partner_source_id : string
  title : string
  registration_date : date
  approval_date : date
  source_label : string
  reason : text
  non_approval_impact : text
  approval_impact : text
  status : string
}
entity project_charters {
  **id** : uuid <<PK>>
  project_id : uuid <<FK>>
  subportfolio_id : uuid <<FK>>
  artifact_id : uuid <<FK>>
  partner_source_id : string
  leader_name : string
  team_text : text
  objective : text
  scope_text : text
  non_scope_text : text
  expected_benefits : text
  start_date : date
  end_date : date
  cost_brl : decimal
  revision_number : int
  tap_situation : string
  release_status : string
}
entity project_closure_terms {
  **id** : uuid <<PK>>
  project_id : uuid <<FK>>
  artifact_id : uuid <<FK>>
  partner_source_id : string
  closure_status : string
  closure_reason : text
  remaining_scope_or_pending_items : text
  actual_cost_brl : decimal
  closure_date : date
}
entity project_benefits {
  **id** : uuid <<PK>>
  project_id : uuid <<FK>>
  charter_id : uuid <<FK>>
  description : text
  benefit_type : string
  expected_value : string
  measurement_indicator : string
}
entity users {
  **id** : uuid <<PK>>
  entra_object_id : string
  display_name : string
  email : string
  role_name : string
}
entity access_rules {
  **id** : uuid <<PK>>
  user_id : uuid <<FK>>
  subportfolio_id : uuid <<FK>>
  project_id : uuid <<FK>>
  role_name : string
  permission_scope : string
  can_read : boolean
  can_write : boolean
}
entity intent_catalog {
  **id** : uuid <<PK>>
  macro_intent : string
  specific_intent : string
  flow_description : string
  target_component : string
  handler_name : string
  macro_confidence_threshold : decimal
  intent_confidence_threshold : decimal
  is_active : boolean
}
entity prompt_templates {
  **id** : uuid <<PK>>
  intent_id : uuid <<FK>>
  template_key : string
  title : string
  prompt_text : text
  channel : string
  purpose : string
}
entity ai_conversations {
  **id** : uuid <<PK>>
  user_id : uuid <<FK>>
  channel : string
  conversation_status : string
}
entity ai_interactions {
  **id** : uuid <<PK>>
  conversation_id : uuid <<FK>>
  user_id : uuid <<FK>>
  intent_id : uuid <<FK>>
  prompt_template_id : uuid <<FK>>
  user_prompt : text
  normalized_prompt : text
  macro_intent_predicted : string
  macro_intent_confidence : decimal
  specific_intent_predicted : string
  specific_intent_confidence : decimal
  handler_selected : string
  route_taken : string
  top_k_alternatives : json
  limitation_response : text
  response_text : text
  processing_status : string
}
entity consulted_sources {
  **id** : uuid <<PK>>
  interaction_id : uuid <<FK>>
  artifact_id : uuid <<FK>>
  extract_id : uuid <<FK>>
  project_id : uuid <<FK>>
  source_type : string
  source_title : string
  source_url : string
  source_locator : string
  citation_order : int
}
entity audit_events {
  **id** : uuid <<PK>>
  interaction_id : uuid <<FK>>
  user_id : uuid <<FK>>
  event_type : string
  component : string
  correlation_id : string
}
entity out_of_scope_requests {
  **id** : uuid <<PK>>
  interaction_id : uuid <<FK>>
  reviewed_by : uuid <<FK>>
  user_prompt : text
  reason : text
  review_status : string
}
entity intent_test_cases {
  **id** : uuid <<PK>>
  intent_id : uuid <<FK>>
  raw_text : text
  normalized_text : text
  template_id : string
  surface_variation : string
  dataset_split : string
  leakage_group : string
}

subportfolios "1" -- "0..*" projects : possui
subportfolios "1" -- "0..*" subportfolio_status_updates : acompanha
subportfolios "1" -- "0..*" risk_issue_items : monitora
subportfolios "1" -- "0..*" change_records : controla
projects "1" -- "0..*" project_progress_updates : mede
projects "1" -- "0..*" project_deliverables_milestones : acompanha
projects "1" -- "0..*" project_artifacts : possui
projects "1" -- "0..*" source_extracts : contextualiza
project_artifacts "1" -- "0..*" source_extracts : gera
projects "1" -- "0..*" schedule_items : possui
project_artifacts "1" -- "0..*" schedule_items : origina
schedule_items "1" -- "0..*" schedule_items : detalha
projects "1" -- "0..*" risk_issue_items : monitora
risk_issue_items "1" -- "0..*" risk_issue_history : versiona
projects "1" -- "0..*" change_records : controla
projects "1" -- "0..*" project_charters : formaliza
project_artifacts "1" -- "0..*" project_charters : estrutura
projects "1" -- "0..*" project_closure_terms : encerra
project_artifacts "1" -- "0..*" project_closure_terms : estrutura
projects "1" -- "0..*" project_benefits : declara
project_charters "1" -- "0..*" project_benefits : detalha
users "1" -- "0..*" access_rules : possui
users "1" -- "0..*" ai_conversations : inicia
users "1" -- "0..*" ai_interactions : realiza
users "1" -- "0..*" audit_events : executa
users "1" -- "0..*" out_of_scope_requests : revisa
intent_catalog "1" -- "0..*" prompt_templates : orienta
intent_catalog "1" -- "0..*" ai_interactions : classifica
intent_catalog "1" -- "0..*" intent_test_cases : valida
prompt_templates "1" -- "0..*" ai_interactions : orienta
ai_conversations "1" -- "0..*" ai_interactions : contem
ai_interactions "1" -- "0..*" consulted_sources : usa
project_artifacts "1" -- "0..*" consulted_sources : referencia
source_extracts "1" -- "0..*" consulted_sources : referencia
projects "1" -- "0..*" consulted_sources : contextualiza
ai_interactions "1" -- "0..*" audit_events : registra
ai_interactions "1" -- "0..*" out_of_scope_requests : gera
@enduml
