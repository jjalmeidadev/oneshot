@startuml classes-consolidado
' Diagrama de classes consolidado - Secao 5.1 do Projeto.md
' Une o pipeline de processamento ao dominio persistido alinhado ao inventario do parceiro.

skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 70
skinparam defaultTextAlignment left
skinparam class {
  BackgroundColor #EEF4FD
  BorderColor #4A7EBB
  ArrowColor #4A5560
  FontSize 12
  AttributeFontSize 11
}
skinparam package {
  BackgroundColor #FAFBFC
  BorderColor #8A949E
  FontStyle bold
  FontSize 13
}
left to right direction

package "Pipeline de processamento" as P1 {
  class Solicitacao {
    +UUID id
    +String texto
    +DateTime dataHora
    +String canal
  }
  class PipelinePLN {
    +classificar(Solicitacao) : Intencao
    +extrairEntidades(Solicitacao) : EntidadeExtraida[]
  }
  class Intencao {
    +UUID id
    +String macrointencao
    +String intencaoEspecifica
    +Float confiancaMacro
    +Float confiancaEspecifica
    +Boolean acimaDoLimiar()
  }
  class RoteadorIntencao {
    +rotear(Intencao) : RotaProcessamento
  }
  class Resposta {
    +String texto
    +Boolean fundamentada
    +declararLimitacao() : String
  }
}

package "Interacao e governanca" as P2 {
  class Conversa {
    +UUID id
    +UUID usuarioId
    +DateTime iniciadaEm
  }
  class Interacao {
    +UUID id
    +UUID conversaId
    +String rota
    +DateTime registradaEm
  }
  class Usuario {
    +UUID id
    +String perfil
    +podeAcessar(Projeto) : Boolean
  }
  class RegraAcesso {
    +UUID id
    +String nivel
  }
  class EventoAuditoria {
    +UUID id
    +String tipo
    +DateTime ocorridoEm
  }
  class SolicitacaoForaDeEscopo {
    +UUID id
    +String motivo
  }
}

package "Conhecimento consultavel" as P3 {
  class Artefato {
    +UUID id
    +String tipo
    +String origem
    +String anexo
  }
  class TrechoRecuperado {
    +UUID id
    +String texto
    +String secao
    +Float relevancia
  }
  class FonteConsultada {
    +UUID id
    +Float score
  }
}

package "Dominio do portfolio" as P4 {
  class Subportfolio {
    +UUID id
    +String titulo
    +String responsavel
    +String membroGpm
  }
  class SituacaoSubportfolio {
    +Date dataReferencia
    +String situacao
    +String ano
  }
  class Projeto {
    +UUID id
    +String titulo
    +String statusProgramaProjeto
  }
  class AvancoProjeto {
    +Date dataReferencia
    +Decimal previstoFisico
    +Decimal realizadoFisico
    +Decimal previstoEconomico
    +Decimal realizadoEconomico
  }
  class EntregaMarco {
    +String descricao
    +Date dataPrevista
    +Date dataRealizada
    +String status
  }
  class ItemCronograma {
    +UUID id
    +String status
    +String referenciaAnexo
  }
  class TermoAbertura {
    +Integer revisao
    +String objetivo
    +String escopo
    +String beneficiosEsperados
    +Decimal custo
  }
  class TermoEncerramento {
    +String situacao
    +String justificativa
    +Decimal custoRealizado
    +Date dataEncerramento
  }
  class RiscoProblema {
    +UUID id
    +String escopo
    +String criticidade
    +String planoAcao
    +Boolean escalar
  }
  class HistoricoRiscoProblema {
    +Date dataReferencia
    +String statusAnterior
    +String novoStatus
  }
  class Mudanca {
    +UUID id
    +String escopo
    +String motivo
    +String impactoAprovacao
  }
  class Beneficio {
    +UUID id
    +String descricao
    +String indicador
  }
}

Solicitacao --> PipelinePLN : processada por
PipelinePLN --> Intencao : produz
Intencao --> RoteadorIntencao : orienta
RoteadorIntencao --> Resposta : resulta em

Solicitacao "1" --> "1" Interacao : registrada como
Conversa "1" *-- "1..*" Interacao
Usuario "1" o-- "0..*" Conversa
Usuario "1" o-- "0..*" RegraAcesso
RegraAcesso ..> Projeto : delimita escopo

Interacao "1" --> "1" Intencao
Interacao "1" *-- "0..1" Resposta
Interacao "1" o-- "0..*" EventoAuditoria
Interacao "1" --> "0..1" SolicitacaoForaDeEscopo

Resposta "1" o-- "0..*" FonteConsultada
FonteConsultada "1" --> "1" TrechoRecuperado
Artefato "1" o-- "0..*" TrechoRecuperado

Subportfolio "1" o-- "0..*" Projeto
Subportfolio "1" o-- "0..*" SituacaoSubportfolio
Subportfolio "1" o-- "0..*" RiscoProblema
Subportfolio "1" o-- "0..*" Mudanca
Projeto "1" o-- "0..*" Artefato
Projeto "1" o-- "0..*" AvancoProjeto
Projeto "1" o-- "0..*" EntregaMarco
Projeto "1" o-- "0..*" ItemCronograma
Projeto "1" o-- "0..*" TermoAbertura
Projeto "1" o-- "0..*" TermoEncerramento
Projeto "1" o-- "0..*" RiscoProblema
Projeto "1" o-- "0..*" Mudanca
Projeto "1" o-- "0..*" Beneficio
TermoAbertura "1" o-- "0..*" Beneficio
RiscoProblema "1" o-- "0..*" HistoricoRiscoProblema

@enduml
