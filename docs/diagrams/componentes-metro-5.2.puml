@startuml componentes-metro-5.2
' Diagrama de Componentes UML — solução efetivamente implementada (S5-43, #297).
' Componentes com <<previsto>> e conexões tracejadas ainda não estão no runtime.

top to bottom direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 30
skinparam ranksep 55
skinparam defaultTextAlignment center
skinparam package {
  BorderColor #546E7A
  BackgroundColor #FAFAFA
  FontStyle bold
}
skinparam component {
  BorderColor #37474F
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam component<<previsto>> {
  BorderColor #9E9E9E
  BackgroundColor #F5F5F5
  FontColor #616161
  BorderStyle dashed
}
skinparam database {
  BorderColor #37474F
  BackgroundColor #FFFFFF
}
skinparam queue {
  BorderColor #37474F
  BackgroundColor #FFFFFF
}
skinparam note {
  BorderColor #F9A825
  BackgroundColor #FFFDE7
  FontSize 10
}

actor "Usuário do PMO" as Usuario

package "1. Canal" {
  component "Chat web\nReact + Vite" as Chat
  component "Aba no Microsoft Teams\n(S5-19)" as Teams <<previsto>>
  component "Copilot via servidor MCP\n(S5-18)" as MCP <<previsto>>
}

package "2. API da aplicação (FastAPI)" {
  component "Rotas de chat e áudio\n/api/chat, /api/audio" as Rotas
  component "Autenticação e\nescopo de acesso" as Acesso
  component "Barreira de\ndado sensível" as Sensivel
  component "Workflows guiados\nrelatório, alerta,\nalteração de dados" as Workflows
  component "Webhooks de entrada\nSharePoint, entrega,\nresultado de relatório" as Webhooks
  component "Trilha de auditoria" as Auditoria
}

package "3. Pilar 1 — PLN e roteamento" {
  component "Pré-processamento\ne entidades" as Pre
  component "Classificador de intenções\nTF-IDF + BERTimbau" as Classificador
  component "Roteamento por catálogo\ne regras de domínio" as Roteamento
}

package "4. Recuperação e geração" {
  component "Recuperador lexical\n(RAG)" as RAG
  component "Contexto, citações\ne validação extrativa" as Contexto
  component "Cliente de LLM\nGemini / OpenRouter" as ClienteLLM
}

package "5. Processamento assíncrono" {
  queue "RabbitMQ\noutbox, filas e DLQ" as Fila
  component "Workers de alerta\nscheduler, publisher, evaluator,\nnotifier, delivery" as WorkersAlerta
  component "Workers do SharePoint\npublisher, consumer" as WorkersSP
}

package "6. Dados" {
  database "PostgreSQL (Supabase)\nportfólio, sessões,\nauditoria, outbox" as DB
  component "Supabase Auth" as Auth
  component "Supabase Storage\nartefatos DOCX" as Storage
  component "Listas SharePoint\nsimuladas (JSON)" as SPMock
}

package "7. Serviços externos" {
  component "Azure AI Speech\nSTT e TTS" as Speech
  component "Provedor de LLM\nGemini / OpenRouter" as LLM
  component "Power Automate\n(opcional; simulador local)" as PA
  component "Entra ID e SharePoint\ncorporativo" as M365 <<previsto>>
}

Usuario --> Chat
Usuario ..> Teams
Usuario ..> MCP
Chat --> Rotas : HTTPS / JSON
Teams ..> Rotas
MCP ..> Rotas
Chat --> Workflows : sessões guiadas

Rotas --> Acesso
Acesso --> Auth : valida JWT
Rotas --> Sensivel
Rotas --> Speech : transcrição / síntese
Rotas --> Pre
Pre --> Classificador
Classificador --> Roteamento
Roteamento --> RAG : consulta documental
Roteamento --> Workflows : intenção funcional
RAG --> SPMock
RAG --> DB
RAG --> Contexto
Contexto --> ClienteLLM
ClienteLLM --> LLM

Workflows --> DB
Workflows --> Storage
Workflows --> PA : HTTP (opcional)
PA --> Webhooks : callback
Webhooks --> Fila
Workflows --> Fila : outbox
Fila --> WorkersAlerta
Fila --> WorkersSP
WorkersAlerta --> DB
WorkersSP --> DB

Rotas --> Auditoria
Workflows --> Auditoria
Auditoria --> DB

M365 ..> Acesso : identidade
M365 ..> RAG : fontes reais

legend right
  |= Notação |= Significado |
  | Caixa contínua, seta contínua | Implementado no runtime atual |
  | Caixa cinza tracejada, seta tracejada | Previsto, sem código integrado |
  Copilot Studio não faz parte da arquitetura:
  o Metrô não o disponibilizou. A conexão com o
  Copilot fica prevista por servidor MCP (S5-18).
endlegend
@enduml
