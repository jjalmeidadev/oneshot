@startuml implantacao-poc
' Diagrama de Implantação UML — PoC publicada na Sprint 4 e evolução prevista (S5-43, #297).

left to right direction
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 60
skinparam defaultTextAlignment center
skinparam node {
  BorderColor #37474F
  BackgroundColor #EEF4FD
}
skinparam cloud {
  BorderColor #546E7A
  BackgroundColor #FAFAFA
}
skinparam artifact {
  BorderColor #37474F
  BackgroundColor #FFFFFF
}
skinparam database {
  BorderColor #37474F
  BackgroundColor #FFFFFF
}
skinparam rectangle<<previsto>> {
  BorderColor #9E9E9E
  BackgroundColor #F5F5F5
  FontColor #616161
  BorderStyle dashed
}
skinparam ArrowColor #4A5560

actor "Usuário do PMO" as Usuario

node "Navegador" as Navegador {
  artifact "Chat web\n(React + Vite)" as SPA
}

cloud "Cloudflare\nQuick Tunnel (HTTPS)" as Tunnel

node "AWS EC2 t3.large\nUbuntu 24.04" as EC2 {
  node "Docker Compose\n(rede privada)" as Compose {
    artifact "frontend\nnginx em 127.0.0.1:80" as Front
    artifact "backend\nFastAPI / Uvicorn" as Back
    artifact "rabbitmq" as Rabbit
    artifact "workers de alerta\nscheduler, publisher,\nevaluator, notifier, delivery" as WAlerta
    artifact "workers do SharePoint\npublisher, consumer" as WSP
  }
  artifact "cloudflared" as Cloudflared
  artifact "CloudWatch Agent" as CWAgent
}

node "AWS ECR" as ECR {
  artifact "imagens backend\ne frontend" as Imagens
}
cloud "AWS CloudWatch" as CloudWatch

cloud "Supabase Cloud" as Supabase {
  database "PostgreSQL" as PG
  artifact "Auth" as SAuth
  artifact "Storage" as SStorage
}

cloud "Microsoft Azure" as Azure {
  artifact "Azure AI Speech\nSTT e TTS" as Speech
}

cloud "Provedor de LLM" as Provedor {
  artifact "Gemini / OpenRouter" as LLM
}


rectangle "Ambiente-alvo do Metrô\n(previsto, Seção 6.4)\nAzure Container Apps, PostgreSQL gerenciado,\nAzure OpenAI, Entra ID, SharePoint via Graph,\naba no Teams e servidor MCP para o Copilot" as Alvo <<previsto>>

Usuario --> SPA
SPA --> Tunnel : HTTPS
Tunnel --> Cloudflared
Cloudflared --> Front : 127.0.0.1:80
Front --> Back : /api (proxy)
Back --> Rabbit : AMQP
Rabbit --> WAlerta
Rabbit --> WSP
Back --> PG : SQL (TLS)
WAlerta --> PG
WSP --> PG
Back --> SAuth : valida JWT
Back --> SStorage : DOCX
Back --> Speech : HTTPS
Back --> LLM : HTTPS
ECR --> Compose : docker pull
CWAgent --> CloudWatch : logs
Compose ..> Alvo : migração prevista
@enduml
